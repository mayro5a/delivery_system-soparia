# ---------------------------------------------------------------------------
# Soparia da Lê — backend/.env
# Copie para backend/.env e preencha. NUNCA versione o .env real.
# ---------------------------------------------------------------------------

# PostgreSQL (o docker-compose.yml da raiz sobe um banco com estes dados)
DATABASE_URL="postgresql://soparia:soparia@localhost:5432/soparia_da_le?schema=public"
# Banco usado SOMENTE pela suíte de testes (opcional; se omitido, deriva de DATABASE_URL + "_test")
TEST_DATABASE_URL="postgresql://soparia:soparia@localhost:5432/soparia_da_le_test?schema=public"

PORT=3333
NODE_ENV=development

# Origem(ns) permitidas pelo CORS (URL do frontend). Separe várias por vírgula.
CORS_ORIGIN="http://localhost:5173"
# URL pública do site
APP_URL="http://localhost:5173"

# JWT — troque por um valor aleatório forte (ex.: openssl rand -hex 32)
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Administrador criado pelo seed (somente ambiente de desenvolvimento)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@sopariadale.com"
ADMIN_PASSWORD=""

# WhatsApp da Soparia (formato internacional, sem símbolos)
WHATSAPP_NUMBER="5592992781331"

# E-mail transacional (confirmação de pagamento e "saiu para entrega") — SMTP
# genérico, funciona com qualquer provedor. Deixe em branco para desligar o
# envio (nada quebra, só fica sem mandar e-mail). Veja o README, seção
# "E-mail transacional", para exemplos de provedores gratuitos.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Soparia da Lê <pedidos@sopariadale.com>"

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE em desenvolvimento e as de PRODUÇÃO no servidor.
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
# Assinatura secreta do webhook (Suas integrações > Webhooks > Assinatura secreta)
MP_WEBHOOK_SECRET=""
# URL pública onde o Mercado Pago enviará as notificações (precisa ser HTTPS acessível pela internet)
MP_WEBHOOK_URL=""
MP_PIX_EXPIRATION_MINUTES=30
MP_STATEMENT_DESCRIPTOR="SOPARIA DA LE"

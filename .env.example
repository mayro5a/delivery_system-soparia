# =========================================================================
# Soparia da Lê — referência de TODAS as variáveis de ambiente
#
# Os arquivos reais ficam em backend/.env e frontend/.env (ambos ignorados
# pelo git). NUNCA coloque valores reais/sensíveis neste arquivo de exemplo.
# =========================================================================

# ---------------------------- backend/.env -------------------------------

# PostgreSQL (docker compose up -d sobe um banco local com estes dados)
DATABASE_URL="postgresql://soparia:soparia@localhost:5432/soparia_da_le?schema=public"
# Banco usado SOMENTE pelos testes automatizados (opcional)
TEST_DATABASE_URL="postgresql://soparia:soparia@localhost:5432/soparia_da_le_test?schema=public"

PORT=3333
NODE_ENV=development

# Origem(ns) permitidas pelo CORS (URL do frontend). Separe várias por vírgula.
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# Segredo usado para assinar os tokens JWT — gere um valor aleatório forte
JWT_SECRET=
JWT_EXPIRES_IN="8h"

# Administrador criado pelo seed (apenas para desenvolvimento/primeiro acesso)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@sopariadale.com"
ADMIN_PASSWORD=

# WhatsApp da Soparia (formato internacional, sem símbolos)
WHATSAPP_NUMBER="5592992781331"

# Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
# O Access Token fica SOMENTE no backend. A Public Key é entregue ao
# navegador pelo endpoint GET /api/payments/config.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Assinatura secreta do webhook (Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=
# URL pública HTTPS do webhook, ex.: https://seu-dominio.com/api/payments/webhook
MP_WEBHOOK_URL=
MP_PIX_EXPIRATION_MINUTES=30
MP_STATEMENT_DESCRIPTOR="SOPARIA DA LE"

# ---------------------------- frontend/.env ------------------------------
VITE_API_URL="http://localhost:3333/api"
VITE_WHATSAPP_NUMBER="5592992781331"
